{
  "name": "modern-mota",
  "version": "0.1.0",
  "private": true,
  "description": "Modern rebuild of the classic 20-floor Magic Tower game",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "corepack pnpm --filter @modern-mota/web dev",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "test:e2e": "corepack pnpm --filter @modern-mota/web test:e2e",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
